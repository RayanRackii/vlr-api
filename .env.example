# PostgreSQL / Supabase Database
# Prefer Transaction pooler (port 6543) for the API; Session mode (5432 pooler) is capped (~15).
# Always set Maximum Pool Size so EF + Hangfire do not exhaust Supabase slots.
ConnectionStrings__DefaultConnection=Host=aws-1-sa-east-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.kbptdzfbngelzdhriyhf;Password=5Xivi71COhltvoOF; SSL Mode=Require;Maximum Pool Size=5;Connection Idle Lifetime=30

# Supabase Auth (JWT validation + Admin API)
Supabase__Url=https://your-project.supabase.co
Supabase__JwtSecret=your-supabase-jwt-secret
Supabase__ServiceRoleKey=your-supabase-service-role-key

# Platform Super-Admin emails (comma-separated via env array indexing also works)
# PlatformAdmin__Emails__0=you@example.com
PlatformAdmin__Emails__0=

# CORS — extra origins beyond built-in defaults (localhost + rolvix.com.br / *.rolvix.com.br).
# Array form also works: Cors__AllowedOrigins__0=https://staging.example.com
Cors__AllowedOrigins=

# ASP.NET Core hosting (Railway / Render / Docker)
ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_URLS=http://+:8080
