{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Booking price changed (HTTP 409)",
  "type": "object",
  "additionalProperties": false,
  "required": ["error", "code", "currentTotalAmount"],
  "properties": {
    "error": { "type": "string", "minLength": 1 },
    "code": { "type": "string", "enum": ["PRICE_CHANGED"] },
    "currentTotalAmount": { "type": "number", "minimum": 0, "multipleOf": 0.01 }
  }
}
